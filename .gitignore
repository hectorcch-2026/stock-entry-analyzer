# 依賴
node_modules/

# 本機設定（含 Telegram token 等機密）
config.json
# 設定檔的備份／暫存：裡面含 bot token 與 LLM apiKey，
# 只 ignore config.json 本身會漏掉 config.json.bak / .tmp / .old 這些。
# 實際踩過：複製備份後差點一起 commit 上去。
config.json.*
!.gitignore

# 測試輸出
tests/out-*.png

# 執行期快取（選股結果／篩選快取，程式會自動建立目錄並重算）
data/

# 系統檔案
.DS_Store
Thumbs.db
*.log

# 一次性資料探勘腳本（不進版控）
/.p/

# 本機暫存（驗證腳本的產出、除錯用的中間檔）
/.tmpv/
# 實際用過的目錄名，跟上面那個不一樣（上面是筆誤留下的舊名，留著不刪以免
# 有人本機還在用）。這裡列出真正會產生的：驗證用的 server.log / DOM dump、
# 以及 e2e 截圖。這些都是「跑一次就有、不該進版控」的東西。
/.tmp-verify/
/.probe/
