{
  "name": "stock-entry-analyzer",
  "version": "1.0.0",
  "description": "美股與港股買入位與技術位分析系統：即時查詢、支撐壓力、均線、量價、歷史回測機率",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "icons": "node scripts/make-icons.js",
    "test:layout": "node tests/e2e-layout.mjs",
    "test:flow": "node tests/e2e-flow.mjs",
    "test:notify": "node tests/e2e-notify.mjs",
    "test:pwa": "node tests/e2e-pwa.mjs",
    "test:ios": "node tests/e2e-ios-standalone.mjs",
    "test:deployed": "node tests/e2e-deployed.mjs",
    "test:escape": "node tests/notify-escape.cjs",
    "test:hidden": "node tests/hidden-visibility.mjs",
    "test:all": "node tests/notify-escape.cjs && node tests/hidden-visibility.mjs && node tests/adv-modules.mjs && node tests/chart-overlays.mjs && node tests/e2e-layout.mjs && node tests/e2e-flow.mjs && node tests/e2e-notify.mjs && node tests/e2e-pwa.mjs && node tests/e2e-ios-standalone.mjs",
    "test:adv": "node tests/adv-modules.mjs",
    "test:chart": "node tests/chart-overlays.mjs",
    "test:forecast": "node tests/forecast-unit.cjs",
    "test:gate": "node scripts/test-gate-negative.js",
    "test:ac01": "node tests/ac01-regression.cjs",
    "test:pred": "node tests/e2e-pred.mjs",
    "test:v14": "node tests/e2e-v14-ui.mjs",
    "test:detail": "node tests/e2e-detail.mjs",
    "verify:intervals": "node scripts/verify-intervals.js",
    "test:fp": "node tests/forecast-unit.cjs && node scripts/test-gate-negative.js && node scripts/verify-intervals.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stock",
    "technical-analysis",
    "entry-point",
    "support-resistance",
    "yahoo-finance",
    "eastmoney",
    "tencent",
    "pwa"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "playwright": "^1.65.1",
    "sharp": "^0.35.5"
  }
}
